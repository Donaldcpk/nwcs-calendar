# Copy to .env.local for local development. Do not commit real secrets.

# Google OAuth (NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Admin access: comma-separated school Google accounts (set in Vercel for production)
ADMIN_EMAILS=

# Optional username/password login (both required to enable)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Supabase (server-side only; use service role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
